{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nmrih2-loadout",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nmrih2-loadouts-shares",
      "database_id": "6738cda6-9067-4360-bbad-5b458896c09a",
      "migrations_dir": "migrations"
    }
  ]
}
